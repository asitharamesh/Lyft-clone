# Copy to .env and fill in real values. Never commit the real .env file.

# Copy to .env and replace the placeholder values before running the app.

# --- Postgres ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=replace_with_local_postgres_password
DB_POOL_MIN_CONN=2
DB_POOL_MAX_CONN=20

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
DRIVER_LOCATION_TTL_SECONDS=120

# --- Auth ---
JWT_SECRET=replace_with_long_random_secret
JWT_EXPIRY_HOURS=12
BCRYPT_ROUNDS=12
FLASK_SECRET_KEY=replace_with_long_random_secret

# Shared secret for the internal ride-simulation engine (ride_simulation_engine.js).
# Must match on both sides. Not a per-user credential - see config.py comment.
SIMULATION_SERVICE_TOKEN=replace_with_long_random_secret

# --- CORS (comma separated origins allowed to call the API / open sockets) ---
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- Rate limiting ---
RATELIMIT_STORAGE_URI=redis://localhost:6379/1
LOGIN_RATE_LIMIT=10 per minute
SIGNUP_RATE_LIMIT=5 per minute

# --- Matching / routing ---
DRIVER_SEARCH_RADIUS_KM=8
DRIVER_SEARCH_CANDIDATES=10
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_TIMEOUT_SECONDS=1.5
USE_LIVE_ROUTING=false
AVG_CITY_SPEED_KMH=28

# --- Misc ---
FLASK_ENV=development
PORT=5001
